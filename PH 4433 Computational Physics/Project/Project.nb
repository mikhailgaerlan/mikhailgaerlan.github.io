            RowBox[{"[", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "All", ",", "1"}], "]"}], "]"}], "]"}],
           ",", 
          RowBox[{"Max", "[", 
           RowBox[{"gendata", "[", 
